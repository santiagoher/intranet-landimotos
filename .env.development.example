# Plantilla: completar con un proyecto Supabase independiente de pruebas.
# Guardar como .env.development.local. No copiar claves de produccion.
# Para la instalacion compartida ya autorizada, ver docs/inventarios-demo-compartido.md.
# No reemplazar su .env.development.local ni publicar INVENTORY_DEMO_SERVER_KEY.
APP_ENV=development
SUPABASE_PRODUCTION_PROJECT_REF=loajbvlgpsxrkfzyxbui
NEXT_PUBLIC_SUPABASE_URL=https://PROYECTO_DE_PRUEBAS.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COMPLETAR_CLAVE_PUBLICA_DE_PRUEBAS
# Solo servidor, si se prueban evidencias; nunca usar NEXT_PUBLIC_:
# Vacio evita heredar accidentalmente la clave de .env.local.
# Completar solo con la clave privada del proyecto de pruebas si se necesita.
SUPABASE_SERVICE_ROLE_KEY=
INVENTORY_SELF_START_ENABLED=false
# Server-only. Enable only after installing/testing supabase/testing/inventarios-demo.sql.
INVENTORY_CATALOG_SOURCE=demo
# Must match the independent Supabase URL host (including port for local Supabase).
INVENTORY_DEMO_TARGET_HOST=PROYECTO_DE_PRUEBAS.supabase.co
